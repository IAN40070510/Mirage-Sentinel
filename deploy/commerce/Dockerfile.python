FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY deploy/commerce/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd -u 10001 -m app && mkdir /state /memory /forensics && chown app /state /memory /forensics
COPY services/__init__.py /app/services/__init__.py
COPY services/commerce /app/services/commerce
USER 10001:10001
CMD ["uvicorn", "services.commerce.gateway:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
