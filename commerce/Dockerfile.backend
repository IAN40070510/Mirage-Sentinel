FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm MEDUSA_DISABLE_TELEMETRY=true
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.11.1 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @dtc/backend build

FROM node:22-bookworm-slim
ENV NODE_ENV=production MEDUSA_DISABLE_TELEMETRY=true
WORKDIR /app
COPY --from=build --chown=node:node /app /app
# MikroORM checks migration directories even for modules with no migrations.
# Create them at image build time so runtime can stay read-only.
RUN find /app/node_modules/.pnpm -type d -path '*/node_modules/@medusajs/*/dist' -exec mkdir -p '{}/migrations' \;
USER node
WORKDIR /app/apps/backend/.medusa/server
CMD ["node", "../../node_modules/@medusajs/cli/cli.js", "start", "--host", "0.0.0.0"]
