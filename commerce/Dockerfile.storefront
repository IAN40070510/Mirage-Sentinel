FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm MEDUSA_DISABLE_TELEMETRY=true
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.11.1 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ARG PUBLIC_URL=http://localhost:8080
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=gateway-managed NEXT_PUBLIC_BASE_URL=$PUBLIC_URL
RUN pnpm --filter @dtc/storefront build

FROM node:22-bookworm-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=8000
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/storefront/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/storefront/.next/static ./apps/storefront/.next/static
COPY --from=build --chown=node:node /app/apps/storefront/public ./apps/storefront/public
USER node
CMD ["node", "apps/storefront/server.js"]
