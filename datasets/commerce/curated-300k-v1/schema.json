{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mirage-sentinel/commerce-request.schema.json",
  "title": "Mirage-Sentinel commerce HTTP request sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "request",
    "label"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "template_family": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path",
        "query",
        "headers",
        "body"
      ],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "query": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "label": {
      "enum": [
        "normal",
        "sqli",
        "xss",
        "cmdi",
        "path_traversal"
      ]
    }
  }
}
